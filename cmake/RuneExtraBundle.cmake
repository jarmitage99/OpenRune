get_filename_component(RUNE_EXTRA_DIR "${CMAKE_CURRENT_LIST_DIR}/../src/script/RuneExtra" ABSOLUTE)
set(RUNE_EXTRA_BUNDLE "${RUNE_EXTRA_DIR}/Prebuilt/RuneExtra.u")
set(RUNE_EXTRA_MANIFEST "${RUNE_EXTRA_DIR}/Prebuilt/manifest.cmake")
file(GLOB RUNE_EXTRA_SOURCES "${RUNE_EXTRA_DIR}/Classes/*.uc")
list(SORT RUNE_EXTRA_SOURCES)
set(RUNE_EXTRA_FINGERPRINT "")
foreach(RUNE_EXTRA_SOURCE IN LISTS RUNE_EXTRA_SOURCES)
  get_filename_component(RUNE_EXTRA_NAME "${RUNE_EXTRA_SOURCE}" NAME)
  file(READ "${RUNE_EXTRA_SOURCE}" RUNE_EXTRA_SOURCE_TEXT)
  string(REPLACE "\r\n" "\n" RUNE_EXTRA_SOURCE_TEXT "${RUNE_EXTRA_SOURCE_TEXT}")
  string(SHA256 RUNE_EXTRA_HASH "${RUNE_EXTRA_SOURCE_TEXT}")
  string(APPEND RUNE_EXTRA_FINGERPRINT "${RUNE_EXTRA_NAME}:${RUNE_EXTRA_HASH}\n")
endforeach()
string(SHA256 RUNE_EXTRA_CURRENT_SOURCE_HASH "${RUNE_EXTRA_FINGERPRINT}")

if(DEFINED RUNE_EXTRA_BUILT_PACKAGE)
  file(MAKE_DIRECTORY "${RUNE_EXTRA_DIR}/Prebuilt")
  file(COPY_FILE "${RUNE_EXTRA_BUILT_PACKAGE}" "${RUNE_EXTRA_BUNDLE}" ONLY_IF_DIFFERENT)
  file(SHA256 "${RUNE_EXTRA_BUNDLE}" RUNE_EXTRA_PACKAGE_HASH)
  file(WRITE "${RUNE_EXTRA_MANIFEST}"
    "set(RUNE_EXTRA_SOURCE_HASH \"${RUNE_EXTRA_CURRENT_SOURCE_HASH}\")\n"
    "set(RUNE_EXTRA_PACKAGE_HASH \"${RUNE_EXTRA_PACKAGE_HASH}\")\n")
else()
  include("${RUNE_EXTRA_MANIFEST}")
  file(SHA256 "${RUNE_EXTRA_BUNDLE}" RUNE_EXTRA_CURRENT_PACKAGE_HASH)
  if(NOT RUNE_EXTRA_CURRENT_SOURCE_HASH STREQUAL RUNE_EXTRA_SOURCE_HASH OR
     NOT RUNE_EXTRA_CURRENT_PACKAGE_HASH STREQUAL RUNE_EXTRA_PACKAGE_HASH)
    message(FATAL_ERROR "RuneExtra bundle is stale or damaged. With game data configured, run: cmake --build build --target update-rune-extra")
  endif()
endif()
